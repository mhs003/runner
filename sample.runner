# {{VAR}} cross-references — vars can reference each other
# {{GREET}} → "Hello world", {{DESC}} → "Hello world from runner"
@vars:
  BIN = app
  PORT = 8080
  NAME = world
  GREET = Hello {{NAME}}
  DESC = {{GREET}} from runner
  # $(cmd) — lazy shell substitution, executed on first use, cached
  # {{HOST}} runs hostname once, second use is cache hit
  HOST = $(hostname)
  TOOL = go
  WHERE = $(which $TOOL)

# session sharing — shell state persists across lines in a task
main:
    MSG="Starting build"
    echo $MSG
    @ build --target x86_64
    @ deploy

# dep arguments — {{--target}} injected into build's vars
build:
    echo "building '{{BIN}}' for '{{--target}}' $MSG"

deploy:
    echo "deploying to {{CWD}} on {{OS}}-{{ARCH}}"

# [exit-on-error] — shell exits on first non-zero command
[exit-on-error]
test:
    echo "running tests..."
    false
    echo "this never runs"

dev:backend:
    echo "Backend dev server started at port :{{PORT}}"

dev:frontend:
    echo "frontend dev server started at port :3000"

hello:
    echo "test test"
    echo "hello world"

# {{@}} — positional CLI args passed through
# $ run greet Hello World          → echo Hello World
# $ run greet -p conf Hello World  → echo Hello World
greet:
    echo {{@}}

# {{@||fallback}} — fallback when no args given
# $ run greet2                      → echo no args
# $ run greet2 Hello World          → echo Hello World
greet2:
    echo {{@||no args}}

# {{@N}} — first N args
# $ run pick2 a b c d e             → echo a b
pick2:
    echo {{@2}}

# {{N@}} — last N args
# $ run last2 a b c d e             → echo d e
last2:
    echo {{2@}}

# {{M@N}} — args from position M to N (1-indexed, inclusive)
# $ run mid a b c d e               → echo b c d
mid:
    echo {{2@4}}

# mixed named flags + {{@}} — named stripped, positionals go to @
# $ run mixed -p conf Hello World   → echo conf Hello World
mixed:
    echo {{-p}} {{@}}

# {{VAR}} ref chain — {{DESC}} → {{GREET}} → {{NAME}} → "Hello world from runner"
desc:
    echo {{DESC}}

# lazy $(cmd) — {{HOST}} executes hostname, cached; second use is cache hit
# {{WHERE}} runs which $TOOL, inherits TOOL=go from @vars env
info:
    echo host={{HOST}}
    echo where={{WHERE}}

# cache proof — {{HOST}} used twice, hostname runs only once
proof:
    echo first={{HOST}}
    echo second={{HOST}}
